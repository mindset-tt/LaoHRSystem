# Copy to .env (which is gitignored) and fill in real values.
# NEVER commit real secrets — Phase 6e enforces this via docker-compose's
# `${VAR:?msg}` syntax, which aborts the stack with a clear message if any
# required variable is missing.

# Postgres
POSTGRES_PASSWORD=replace-me-with-a-strong-random-value

# JWT signing key — minimum 64 random chars recommended.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_KEY=replace-me-with-a-strong-random-value

# Comma-separated list of trusted frontend origins for non-Development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public base URL the browser hits — baked into the frontend image.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: OpenTelemetry OTLP collector endpoint. Leave blank to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=
